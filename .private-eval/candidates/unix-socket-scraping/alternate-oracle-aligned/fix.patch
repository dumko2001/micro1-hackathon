+type unixClientRegistry struct {
+	clients map[string]*http.Client
+}
+
+func (r *unixClientRegistry) acquire(socketPath string, cfg config_util.HTTPClientConfig, name string, opts ...config_util.HTTPClientOption) *http.Client {
+	if r.clients == nil {
+		r.clients = make(map[string]*http.Client)
+	}
+	if client := r.clients[socketPath]; client != nil {
+		return client
+	}
+
+	client, err := newUnixClient(socketPath, cfg, name, opts...)
+	if err != nil {
+		client = &http.Client{Transport: fixedErrorTransport{err: err}}
+	}
+	r.clients[socketPath] = client
+	return client
+}
+
+func (r *unixClientRegistry) retain(active map[string]struct{}) {
+	for path, client := range r.clients {
+		if _, ok := active[path]; ok {
+			continue
+		}
+		client.CloseIdleConnections()
+		delete(r.clients, path)
+	}
+}
+
+func (r *unixClientRegistry) close() {
+	for path, client := range r.clients {
+		client.CloseIdleConnections()
+		delete(r.clients, path)
+	}
+}
+
+func (sp *scrapePool) clientFor(t *Target) *http.Client {
