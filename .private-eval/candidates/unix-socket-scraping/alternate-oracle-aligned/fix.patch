+const unixSocketLabel = "__unix_socket__"
+
+type fixedErrorTransport struct {
+	err error
+}
+
+func (t fixedErrorTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, t.err
+}
+
+func newUnixClient(socketPath string, cfg config_util.HTTPClientConfig, name string, opts ...config_util.HTTPClientOption) (*http.Client, error) {
+	dialer := &net.Dialer{}
+	dialUnix := config_util.WithDialContextFunc(func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return dialer.DialContext(ctx, "unix", socketPath)
+	})
+	opts = append([]config_util.HTTPClientOption{dialUnix}, opts...)
+	return newScrapeClient(cfg, name, opts...)
+}
