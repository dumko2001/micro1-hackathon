+const unixSocketAddressLabel = "__unix_socket__"
+
+func (sp *scrapePool) scraperForTarget(t *Target, timeout time.Duration, escapingScheme model.EscapingScheme) (*targetScraper, error) {
+	client := sp.client
+	ownedClient := false
+	if socketPath := t.labels.Get(unixSocketAddressLabel); socketPath != "" {
+		var opts []config_util.HTTPClientOption
+		if sp.options != nil {
+			opts = append(opts, sp.options.HTTPClientOptions...)
+		}
+		dialer := &net.Dialer{}
+		opts = append(opts, config_util.WithDialContextFunc(func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return dialer.DialContext(ctx, "unix", socketPath)
+		}))
+		var err error
+		client, err = newScrapeClient(sp.config.HTTPClientConfig, sp.config.JobName, opts...)
+		if err != nil {
+			return nil, err
+		}
+		ownedClient = true
+	}
+	return &targetScraper{
+		Target:               t,
+		client:               client,
+		ownedClient:          ownedClient,
+		timeout:              timeout,
+		bodySizeLimit:        int64(sp.config.BodySizeLimit),
+		acceptHeader:         acceptHeader(sp.config.ScrapeProtocols, escapingScheme),
+		acceptEncodingHeader: acceptEncodingHeader(sp.config.EnableCompression),
+		metrics:              sp.metrics,
+	}, nil
+}
+
+func (s *targetScraper) closeIdleConnections() {
+	if s.ownedClient {
+		s.client.CloseIdleConnections()
+	}
+}
