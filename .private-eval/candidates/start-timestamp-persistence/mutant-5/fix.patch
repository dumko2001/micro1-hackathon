diff --git a/tsdb/chunks/chunks.go b/tsdb/chunks/chunks.go
--- a/tsdb/chunks/chunks.go
+++ b/tsdb/chunks/chunks.go
@@ -708,6 +708,25 @@ func (s *Reader) Size() int64 {
 	return s.size
 }
 
+type blockHistogramIterable struct {
+	chunkenc.Chunk
+}
+
+func (i blockHistogramIterable) Iterator(reuse chunkenc.Iterator) chunkenc.Iterator {
+	if wrapped, ok := reuse.(*blockHistogramIterator); ok {
+		reuse = wrapped.Iterator
+	}
+	return &blockHistogramIterator{Iterator: i.Chunk.Iterator(reuse)}
+}
+
+type blockHistogramIterator struct {
+	chunkenc.Iterator
+}
+
+func (*blockHistogramIterator) AtST() int64 {
