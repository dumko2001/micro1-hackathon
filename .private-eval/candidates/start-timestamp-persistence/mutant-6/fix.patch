diff --git a/tsdb/head_append_v2.go b/tsdb/head_append_v2.go
--- a/tsdb/head_append_v2.go
+++ b/tsdb/head_append_v2.go
@@ -272,6 +272,9 @@ func (a *headAppenderV2) appendHistogram(s *memSeries, st, t int64, h *histogram
 		sTyp = stCustomBucketHistogram
 	}
 	b := a.getCurrentBatch(sTyp, s.ref)
+	if len(b.histograms) > 0 && value.IsStaleNaN(b.histograms[len(b.histograms)-1].H.Sum) && !value.IsStaleNaN(h.Sum) {
+		st = 0
+	}
 	b.histograms = append(b.histograms, record.RefHistogramSample{Ref: s.ref, ST: st, T: t, H: h})
 	b.histogramSeries = append(b.histogramSeries, s)
 	return nil
@@ -302,6 +305,9 @@ func (a *headAppenderV2) appendFloatHistogram(s *memSeries, st, t int64, fh *his
 		sTyp = stCustomBucketFloatHistogram
 	}
 	b := a.getCurrentBatch(sTyp, s.ref)
+	if len(b.floatHistograms) > 0 && value.IsStaleNaN(b.floatHistograms[len(b.floatHistograms)-1].FH.Sum) && !value.IsStaleNaN(fh.Sum) {
+		st = 0
+	}
 	b.floatHistograms = append(b.floatHistograms, record.RefFloatHistogramSample{Ref: s.ref, ST: st, T: t, FH: fh})
 	b.floatHistogramSeries = append(b.floatHistogramSeries, s)
 	return nil
