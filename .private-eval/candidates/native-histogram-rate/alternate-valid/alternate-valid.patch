+func extendedHistogramWindow(points []HPoint, rangeStart, rangeEnd int64, smoothed, isCounter bool, annos *annotations.Annotations, pos posrange.PositionRange) ([]HPoint, error) {
+	last := len(points) - 1
+	first := max(0, sort.Search(last, func(i int) bool { return points[i].T > rangeStart })-1)
+	if smoothed {
+		last = sort.Search(last, func(i int) bool { return points[i].T >= rangeEnd })
+	}
+	if points[last].T <= rangeStart || smoothed && points[first].T > rangeEnd {
+		return nil, nil
+	}
+
+	left := HPoint{T: points[first].T, H: points[first].H.Copy()}
+	leftCrossedReset := false
+	if smoothed && points[first].T < rangeStart && first < last {
+		var err error
+		left.H, err = blendHistogram(points[first], points[first+1], rangeStart, isCounter, annos, pos)
+		if err != nil {
+			return nil, err
+		}
+		left.T = rangeStart
+		leftCrossedReset = isCounter && points[first+1].H.DetectReset(points[first].H)
+	}
+
+	right := HPoint{T: points[last].T, H: points[last].H.Copy()}
+	if smoothed && points[last].T > rangeEnd && last > first {
+		var err error
+		right.H, err = blendHistogram(points[last-1], points[last], rangeEnd, isCounter, annos, pos)
+		if err != nil {
+			return nil, err
+		}
+		right.T = rangeEnd
+	}
+
+	window := make([]HPoint, 0, last-first+2)
+	window = append(window, left)
+	for i := first + 1; i < last; i++ {
+		if points[i].T <= left.T || points[i].T >= right.T {
+			continue
+		}
+		point := HPoint{T: points[i].T, H: points[i].H.Copy()}
+		if leftCrossedReset && i == first+1 {
+			point.H.CounterResetHint = histogram.NotCounterReset
+		}
+		window = append(window, point)
+	}
+	if right.T != left.T {
+		if leftCrossedReset && last == first+1 {
+			right.H.CounterResetHint = histogram.NotCounterReset
+		}
+		window = append(window, right)
+	}
+	return window, nil
+}
+
+func histogramExtendedRate(vals Matrix, args parser.Expressions, enh *EvalNodeHelper, isCounter, isRate bool) (Vector, annotations.Annotations) {
+	ms := args[0].(*parser.MatrixSelector)
+	vs := ms.VectorSelector.(*parser.VectorSelector)
+	samples := vals[0]
+	points := samples.Histograms
+	rangeStart := enh.Ts - durationMilliseconds(ms.Range+vs.Offset)
+	rangeEnd := enh.Ts - durationMilliseconds(vs.Offset)
+	metricName := getMetricName(samples.Metric)
+	pos := args[0].PositionRange()
+	var annos annotations.Annotations
+
+	window, err := extendedHistogramWindow(points, rangeStart, rangeEnd, vs.Smoothed, isCounter, &annos, pos)
+	if err != nil {
+		if errors.Is(err, histogram.ErrHistogramsIncompatibleSchema) {
+			annos.Add(annotations.NewMixedExponentialCustomHistogramsWarning(metricName, pos))
+		}
+		return enh.Out, annos
+	}
+	if len(window) == 0 {
+		return enh.Out, annos
+	}
+	customBuckets := window[0].H.UsesCustomBuckets()
+	for _, point := range window[1:] {
+		if point.H.UsesCustomBuckets() != customBuckets {
+			annos.Add(annotations.NewMixedExponentialCustomHistogramsWarning(metricName, pos))
+			return enh.Out, annos
+		}
+	}
+	if len(window) == 1 {
+		duplicate := HPoint{T: window[0].T, H: window[0].H.Copy()}
+		if isCounter {
+			duplicate.H.CounterResetHint = histogram.NotCounterReset
+		}
+		window = append(window, duplicate)
+	}
+	if !isCounter && (points[0].H.CounterResetHint != histogram.GaugeType || points[len(points)-1].H.CounterResetHint != histogram.GaugeType) {
+		annos.Add(annotations.NewNativeHistogramNotGaugeWarning(metricName, pos))
+	}
+	result, rateAnnos := histogramRate(window, nil, isCounter, samples.Metric, pos)
+	annos.Merge(rateAnnos)
+	if result == nil {
+		return enh.Out, annos
+	}
+	if isRate {
+		result.Div(ms.Range.Seconds())
+	}
+	result.CounterResetHint = histogram.GaugeType
+	return append(enh.Out, Sample{H: result.Compact(0)}), annos
+}
