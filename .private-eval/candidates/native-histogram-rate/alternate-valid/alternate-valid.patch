+func blendHistogram(p1, p2 HPoint, t int64, isCounter bool, annos *annotations.Annotations, pos posrange.PositionRange) (*histogram.FloatHistogram, error) {
+	if t == p1.T {
+		return p1.H.Copy(), nil
+	}
+	if t == p2.T {
+		return p2.H.Copy(), nil
+	}
+	if p1.H.UsesCustomBuckets() != p2.H.UsesCustomBuckets() {
+		return nil, histogram.ErrHistogramsIncompatibleSchema
+	}
+	fraction := float64(t-p1.T) / float64(p2.T-p1.T)
+	reset := isCounter && p2.H.DetectReset(p1.H)
+	if reset {
+		result := p2.H.Copy().Mul(fraction)
+		result.CounterResetHint = histogram.CounterReset
+		return result, nil
+	}
+	result := p2.H.Copy()
+	_, _, reconciled, err := result.Sub(p1.H)
+	if err != nil {
+		return nil, err
+	}
+	if reconciled {
+		annos.Add(annotations.NewMismatchedCustomBucketsHistogramsInfo(pos, annotations.HistogramSub))
+	}
+	result.Mul(fraction)
+	_, _, reconciled, err = result.Add(p1.H)
+	if err != nil {
+		return nil, err
+	}
+	if reconciled {
+		annos.Add(annotations.NewMismatchedCustomBucketsHistogramsInfo(pos, annotations.HistogramAdd))
+	}
+	if isCounter {
+		result.CounterResetHint = histogram.NotCounterReset
+	} else {
+		result.CounterResetHint = histogram.GaugeType
+	}
+	return result, nil
+}
